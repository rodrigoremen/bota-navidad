// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL de conexión se configura en prisma.config.ts (Prisma 7+)
}

model Profile {
  id              Int              @id @default(autoincrement())
  name            String
  password        String?          // Contraseña sin encriptar
  fotoPerfil      String?          // URL de Cloudinary o null
  colorFavorito   String?          // Color favorito
  tallaPlayera    String?          // XS, S, M, L, XL, XXL
  tallaPantalon   String?          // 28, 30, 32, etc
  tallaTenis      String?          // 5, 6, 7, etc
  pasatiempos     String?          // Hobbies o intereses
  comidaFavorita  String?          // Comida favorita
  notas           String?          // Notas adicionales
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  wishlist        WishlistItem[]
  ownedGroups     Group[]          @relation("GroupOwner")
  memberships     GroupMember[]
}

model Group {
  id             Int           @id @default(autoincrement())
  name           String
  code           String        @unique
  exchangeDate   DateTime?
  budget         Float?
  allowComments  Boolean       @default(true)
  ownerId        Int
  owner          Profile       @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        GroupMember[]
  wishlist       WishlistItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  profileId Int
  role      String   @default("member") // owner | member
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([groupId, profileId])
}

model WishlistItem {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  image       String?  // URL de la imagen del regalo
  description String?  // Descripción del regalo
  price       Float?   // Precio aproximado
  category    String?  // Categoría (Tecnología, Ropa, Libros, etc)
  priority    String?  // Alta, Media, Baja
  profileId   Int
  profile     Profile  @relation(fields: [profileId], references: [id])
  groupId     Int?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
